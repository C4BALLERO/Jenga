# ---------------------------------------------------------------------------
# TechCompare — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena solo lo que necesites.
# La aplicación ARRANCA Y FUNCIONA sin ninguna de estas variables: en ese caso
# usa el catálogo inicial incluido en el repositorio.
#
# NUNCA subas `.env.local` al repositorio.
# ---------------------------------------------------------------------------

# --- Sitio -----------------------------------------------------------------
# URL pública. Se usa para canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de datos ---------------------------------------------------------
# PostgreSQL. Sin esta variable la web funciona con el catálogo de demostración.
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/techcompare?schema=public

# --- Seguridad -------------------------------------------------------------
# Token del panel /admin. Sin él, el panel NO es accesible (comportamiento
# deseado). Mínimo 16 caracteres. Genera uno con: openssl rand -hex 32
# ADMIN_TOKEN=

# Secreto de los cron jobs. Vercel Cron lo envía como `Authorization: Bearer`.
# CRON_SECRET=

# --- Tipos de cambio -------------------------------------------------------
# Conversión para mostrar precios. Los precios se guardan SIEMPRE en su moneda
# original; esto solo afecta a la conversión mostrada.
# EXCHANGE_RATE_USD_BOB=6.96
# EXCHANGE_RATE_EUR_BOB=7.60
# Endpoint opcional que devuelva { "rates": { "USD": 1, "BOB": 6.96, ... } }
# EXCHANGE_RATE_API_URL=

# --- Analítica y publicidad ------------------------------------------------
# Sin estos valores no se carga ningún script de terceros.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADS_ENABLED=false

# ---------------------------------------------------------------------------
# Proveedores de catálogo
#
# IMPORTANTE: ninguna de estas marcas publica hoy una API abierta de catálogo
# verificable. Los proveedores están registrados e inactivos; se activan al
# configurar credenciales de una integración AUTORIZADA (API de partner, feed
# de afiliados o catálogo cedido). No se hace scraping de ningún sitio.
# ---------------------------------------------------------------------------

# --- Smartphones -----------------------------------------------------------
# APPLE_API_KEY=
# SAMSUNG_API_KEY=
# XIAOMI_API_KEY=
# MOTOROLA_API_KEY=
# GOOGLE_STORE_API_KEY=
# ONEPLUS_API_KEY=
# HONOR_API_KEY=
# OPPO_API_KEY=
# VIVO_API_KEY=
# HUAWEI_API_KEY=

# --- Computación -----------------------------------------------------------
# NVIDIA_API_KEY=
# AMD_API_KEY=
# INTEL_API_KEY=
# LENOVO_API_KEY=
# ASUS_API_KEY=
# ACER_API_KEY=
# HP_API_KEY=
# DELL_API_KEY=
# MSI_API_KEY=
# GIGABYTE_API_KEY=
# MICROSOFT_API_KEY=

# --- Tiendas ---------------------------------------------------------------
# Mercado Libre: API oficial documentada en https://developers.mercadolibre.com
# Requiere aplicación registrada y access token propio.
# MERCADOLIBRE_ACCESS_TOKEN=
# MERCADOLIBRE_SITE_ID=MLA

# Amazon Product Advertising API 5.0: requiere ser afiliado aprobado.
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# --- Feeds de tiendas (CSV / XML / JSON) -----------------------------------
# Vía habitual para comercios locales sin API: la tienda entrega una URL de
# catálogo. Requiere autorización escrita del comercio.
# RETAILER_BO_A_FEED_URL=
# RETAILER_BO_A_TOKEN=
# RETAILER_BO_B_FEED_URL=
# RETAILER_MERCHANT_FEED_URL=
